# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=changeme
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres via Supabase/Neon in production, docker-compose locally)
DATABASE_URL=postgresql://mindcare:mindcare@localhost:5432/mindcare

# Test database (config.settings.test). Tests NEVER use DATABASE_URL, which may
# point at production. Must be a localhost Postgres; the test settings refuse any
# other host. Defaults to the docker-compose `db` service if unset.
TEST_DATABASE_URL=postgresql://mindcare:mindcare@localhost:5432/mindcare

# Redis (Celery broker/result backend; Redis Cloud in production)
REDIS_URL=redis://localhost:6379/0

# JWT (djangorestframework-simplejwt)
JWT_SIGNING_KEY=changeme
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Stripe
STRIPE_SECRET_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme

# Zoom
ZOOM_API_KEY=changeme
ZOOM_API_SECRET=changeme

# Firebase Cloud Messaging
FCM_SERVER_KEY=changeme
FCM_CREDENTIALS_FILE=changeme

# MindCare AI inference service (base URL, no trailing /predict)
AI_SERVICE_URL=https://mindcare-api-fysd.onrender.com

# Extra CORS origins, comma-separated (e.g. a local Flutter web build:
# http://localhost:5000). Leave unset in production unless needed for a demo.
CORS_EXTRA_ALLOWED_ORIGINS=
